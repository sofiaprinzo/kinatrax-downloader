KINATRAX_API_KEY=
KINATRAX_BASE_URL=https://explorer-api.kinatrax.com
KINATRAX_API_PATH=/ktx_s3
KINATRAX_REMOTE_ROOT=Data/CPS
KINATRAX_LOCAL_RAW_ROOT=staging/raw
KINATRAX_RATE_LIMIT_CALLS=5
KINATRAX_RATE_LIMIT_SECONDS=30
KINATRAX_MAX_RETRIES=3

DATABASE_URL=postgresql://localhost:5432/kinatrax_downloader
KINATRAX_INGEST_LOG_TABLE=staging_level.kinatrax_ingest_log
